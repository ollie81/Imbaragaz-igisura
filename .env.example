# -----------------------------------------------------------------------------
# Copy to .env.local for local development:  cp .env.example .env.local
# On Vercel, set the same variables in Project Settings → Environment Variables.
# -----------------------------------------------------------------------------

# Public URL of the site, without trailing slash. Used for canonical URLs,
# sitemap, Open Graph and QR codes.
#   local:      http://localhost:3000
#   production: https://<your-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and PUBLISHABLE key (Dashboard → Project Settings → API Keys).
# The publishable key (sb_publishable_…) is safe in the browser: Row Level
# Security decides what it can read or write. A legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase SECRET key (sb_secret_…, or the legacy "service_role" key).
# SERVER ONLY — bypasses Row Level Security. Never prefix with NEXT_PUBLIC_,
# never commit it, never use it in client code. Not required to run the site yet.
SUPABASE_SECRET_KEY=
